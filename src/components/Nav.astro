const navLinks = [
    { text: 'Home', link: '#home' },
    { text: 'About', link: '#about' },
    { text: 'Projects', link: '#projects' },
    { text: 'Contact', link: '#contact' },
];

const socialLinks = [
    { icon: 'github', link: 'https://github.com/amot-dev' },
    { icon: 'linkedin', link: 'https://www.linkedin.com/in/amot-dev/' },
];
---

<nav id="nav">
    <h1 id="title">Ale<span class="green">x</span>ander <span class="green">Mot</span></h1>
    <div id="buttons">
        {navLinks.map((item) => (
            <a href={item.link} class="button section-button">{item.text}</a>
        ))}

        {socialLinks.map((social) => (
            <a href={social.link} class="button social-button" target="_blank" rel="noopener noreferrer" aria-label={social.icon}>
                <svg class="social-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" set:html={SOCIAL_ICONS[social.icon as keyof typeof SOCIAL_ICONS]}></svg>
            </a>
        ))}
    </div>
</nav>

<style lang="scss">
    @use "../breakpoints.module.scss" as breakpoints;

    nav {
        position: fixed;
        top: 0;
        z-index: 1000;
        font-size: 0;
    }

    #title {
        display: block;
        padding: 0.5rem 1rem;
        font-family: 'Chakra Petch', sans-serif;
        font-size: 4rem;
        color: #ffffff;
        background-color: #404040;
        transition: 0.5s;

        &.scrolled {
            font-size: 1.5rem;
        }
    }

    @media (min-width: breakpoints.$min-width-single-row-scrolled) {
        #title.scrolled {
            display: inline-block;
        }
    }

    @media (min-width: breakpoints.$min-width-single-row-unscrolled) {
        #title:not(.scrolled) {
            display: inline-block;
        }
    }

    .green {
        font-family: inherit;
        font-size: inherit;
        color: #b5d854;
    }

    #buttons {
        display: block;
        vertical-align: top;
        background-color: #b5d854;
        transition: 0.2s;

        &.display-transitioning {
            opacity: 0;
        }

        > .section-button {
            font-family: 'Chakra Petch', sans-serif;
            font-size: 1.5rem;
        }
    }

    @media (max-width: breakpoints.$max-width-inline-socials) {
        #buttons {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;

            .section-button {
                order: 1;
            }

            .social-button {
                order: 3;
            }

            &::before {
                content: "";
                order: 2;
                flex-basis: 100%;
                height: 0;
            }
        }
    }

    @media (min-width: breakpoints.$min-width-single-row-scrolled) {
        #buttons.scrolled {
            display: inline-block;
        }
    }

    @media (min-width: breakpoints.$min-width-single-row-unscrolled) {
        #buttons:not(.scrolled) {
            display: inline-block;
        }
    }

    .social-button {
        line-height: 0;
    }

    .social-icon {
        height: 33px;
        fill: #000000;
    }
</style>

<script>
    // @ts-ignore
    import breakpoints from '../breakpoints.module.scss';

    const title = document.getElementById('title');
    const buttons = document.getElementById('buttons');

    const minWidthSingleRowUnscrolled = parseInt(breakpoints.minWidthSingleRowUnscrolled, 10);
    const minWidthSingleRowScrolled = parseInt(breakpoints.minWidthSingleRowScrolled, 10);
    const transitionMediaQuery = window.matchMedia(`(min-width: ${minWidthSingleRowScrolled}px) and (max-width: ${minWidthSingleRowUnscrolled - 1}px)`);

    const scrollFunction = () => {
        if (!title || !buttons) return;

        const scrollPosition = document.body.scrollTop || document.documentElement.scrollTop;
        const scrollThreshold = 0.8 * window.innerHeight;

        // Scrolling down
        if (scrollPosition > scrollThreshold) {
            // Need to transition display style when between transition sizes (done by making buttons transparent during display change)
            // This is because between those sizes, the navbar needs to move from inline to a new row or vice versa
            if (transitionMediaQuery.matches && !buttons.classList.contains('scrolled')) {
                buttons.classList.add('display-transitioning');
                title.classList.add('scrolled');
                buttons.classList.add('scrolled');

                // Wait until there's enough room for both title and navbar before completing button transition
                const checkWidthSubceeds = () => {
                    const viewportWidth = window.innerWidth || document.documentElement.clientWidth;
                    if (title.offsetWidth + buttons.offsetWidth < viewportWidth) {
                        buttons.classList.remove('display-transitioning');
                    } else {
                        // If there's no room, check again on the next animation frame
                        requestAnimationFrame(checkWidthSubceeds);
                    }
                };
                requestAnimationFrame(checkWidthSubceeds);
            } else {
                title.classList.add('scrolled');
                buttons.classList.add('scrolled');
            }
        }
        // Scrolling up
        else {
            if (transitionMediaQuery.matches && buttons.classList.contains('scrolled')) {
                // Start scroll animation
                buttons.classList.add('display-transitioning');
                title.classList.remove('scrolled');
                buttons.classList.remove('scrolled');

                // Wait until there's not enough room for both title and navbar before completing button transition
                const checkWidthExceeds = () => {
                    const viewportWidth = window.innerWidth || document.documentElement.clientWidth;
                    if (title.offsetWidth + buttons.offsetWidth > viewportWidth) {
                        buttons.classList.remove('display-transitioning');
                    } else {
                        requestAnimationFrame(checkWidthExceeds);
                    }
                };
                requestAnimationFrame(checkWidthExceeds);
            } else {
                title.classList.remove('scrolled');
                buttons.classList.remove('scrolled');
            }
        }
    };

    let ticking = false;
    const handleScroll = () => {
        if (!ticking) {
            window.requestAnimationFrame(() => {
                scrollFunction();
                ticking = false;
            });
            ticking = true;
        }
    };
    window.addEventListener('scroll', handleScroll);
</script>


<!-- Dev code to calculate breakpoints -->
<script>
    declare global {
        interface Window {
            calculateNavBreakpoints: () => string;
        }
    }

    // @ts-ignore
    if (import.meta.env.DEV) {
        window.calculateNavBreakpoints = function() {
            const title = document.getElementById('title');
            const buttons = document.getElementById('buttons');

            if (!title || !buttons) return "Error: Elements not found";

            const wasScrolled = title.classList.contains('scrolled');
            const originalTitleDisplay = title.style.display;
            const originalButtonsDisplay = buttons.style.display;
            const originalButtonsWhiteSpace = buttons.style.whiteSpace;
            const origButtonsWidth = buttons.style.width;
            const originalTitleTransition = title.style.transition;
            const originalButtonsTransition = buttons.style.transition;

            title.style.transition = 'none';
            buttons.style.transition = 'none';
            title.style.display = 'inline-block';
            buttons.style.display = 'inline-block';
            buttons.style.whiteSpace = 'nowrap';
            buttons.style.width = 'max-content';

            title.classList.remove('scrolled');
            buttons.classList.remove('scrolled');
            const minWidthSingleRowUnscrolled = title.offsetWidth + buttons.offsetWidth + 1;

            title.classList.add('scrolled');
            buttons.classList.add('scrolled');
            const minWidthSingleRowScrolled = title.offsetWidth + buttons.offsetWidth + 1;

            const maxWidthInlineSocials = buttons.offsetWidth + 1;

            if (!wasScrolled) {
                title.classList.remove('scrolled');
                buttons.classList.remove('scrolled');
            }
            title.style.display = originalTitleDisplay;
            buttons.style.display = originalButtonsDisplay;
            buttons.style.whiteSpace = originalButtonsWhiteSpace;
            buttons.style.width = origButtonsWidth;
            title.style.transition = originalTitleTransition;
            buttons.style.transition = originalButtonsTransition;

            const output = [
                `$min-width-single-row-unscrolled: ${minWidthSingleRowUnscrolled}px;`,
                `$min-width-single-row-scrolled: ${minWidthSingleRowScrolled}px;`,
                `$max-width-inline-socials: ${maxWidthInlineSocials}px;`
            ].join('\n');

            console.log(`%c${output}`, 'color: #b5d854; font-family: monospace;');

            return "Copy the above into breakpoints.module.scss"
        };
    };
</script>
